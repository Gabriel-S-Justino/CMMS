# URL base da API do CMMS, já incluindo o prefixo /api/v1 da spec.
# Precisa do prefixo EXPO_PUBLIC_ para o Expo expor a variável no bundle.
#
# Sem esta variável o app roda em modo mock (src/data/mock-assets.ts),
# sem backend.
#
# Emulador Android: use http://10.0.2.2:8000/api/v1
# Dispositivo físico: use o IP da sua máquina na rede local
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# ----------------------------------------------------------------------------
# CMMS — variáveis de ambiente. Copie para .env e ajuste os valores.
#   cp .env.example .env
# O .env está no .gitignore e NUNCA deve ser versionado.
# ----------------------------------------------------------------------------

# --- Banco de dados ---------------------------------------------------------
POSTGRES_USER=cmms
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=cmms

# --- API --------------------------------------------------------------------
# Porta publicada no host (o container sempre escuta na 8000 internamente).
API_PORT=8080

# Chave de assinatura dos JWT. Gere uma sua:  openssl rand -hex 32
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-bytes

# DEBUG=true libera o /docs e o /redoc. Mantenha false em produção.
DEBUG=false

# Origens liberadas no CORS, separadas por vírgula.
# 8081 é a porta padrão do Metro/Expo Web.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Proxies reversos em que o uvicorn pode confiar para ler X-Forwarded-For/Proto.
# Vazio = nenhum (padrão seguro): o IP registrado na auditoria é o do peer TCP.
# Atrás de nginx/Traefik na mesma máquina, use "127.0.0.1"; se o proxy é um
# container do compose, use o IP dele — nunca "*" exposto à internet.
FORWARDED_ALLOW_IPS=

# Porta do postgres no host. Só tem efeito com o docker-compose.override.yml
# (arquivo local, fora do Git); no compose versionado o banco não publica porta.
POSTGRES_HOST_PORT=5432

# --- Admin inicial (criado pelo seeds/perfis_permissoes.py) -----------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cmms.com.br
ADMIN_PASSWORD=troque-esta-senha-admin
